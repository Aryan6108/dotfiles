{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "/home/sikder/Pictures/292.png",
    "height": 7,
    "width": 14,
    "padding": {
      "top": 1,
      "left": 2
    },
    "color": {
      "1": "#d5a55f",
      "2": "#63b0d5"
    }
  },
  "display": {
    "separator": "| ",
    "color": {
      "separator": "bright_black",
      "keys": "#d5a55f",
      "title": "#88b0d5"
    }
  },
  "modules": [
    "break",
    {
      "type": "cpu",
      "key": "CPU  ",
      "keyColor": "cyan",
      "temp": true,
      "format": "{7} - {8}"
    },
    {
      "type": "gpu",
      "key": "GPU  ",
      "keyColor": "blue",
      "temp": true,
      "driverSpecific": true,
      "format": "{12} - {4}"
    },
    {
      "type": "memory",
      "key": "RAM  ",
      "keyColor": "magenta",
      "format": "{1} / {2}"
    },
    {
      "type": "swap",
      "key": "Swap ",
      "keyColor": "magenta",
      "format": "{1} / {2}"
    },
    {
      "type": "disk",
      "key": "Disk ",
      "keyColor": "green",
      "folders": "/",
      "format": "{1} / {2}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
